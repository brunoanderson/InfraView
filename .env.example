# Copie este arquivo para .env e ajuste os valores.
# Nunca versione o .env: ele contém segredos.

# Ambiente: development | production | test
NODE_ENV=development

# Porta HTTP do servidor Express
PORT=3000

# Caminho do arquivo SQLite (relativo à raiz do projeto)
DATABASE_URL=./db/infraview.db

# Segredo usado para assinar os tokens JWT (mínimo 32 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# Validade do token (formato do jsonwebtoken: 15m, 1h, 8h, 7d...)
JWT_EXPIRES_IN=8h

# Origem(ns) permitida(s) no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:3000

# Administrador de demonstração criado por npm run db:seed / db:reset.
# Senha de DEMONSTRAÇÃO (mínimo 8 caracteres); troque se o projeto for publicado.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@infraview.local
SEED_ADMIN_PASSWORD=Admin@123

# Monitoramento automático dos dispositivos
MONITOR_ENABLED=true
# Intervalo entre rodadas de verificação (mínimo 5). Para a apresentação, use 5.
MONITOR_INTERVAL_SECONDS=30
# Tempo máximo de espera de cada verificação (ping/tcp/http)
MONITOR_TIMEOUT_MS=2000
# Falhas seguidas até marcar o dispositivo como offline
MONITOR_FAILURE_THRESHOLD=3

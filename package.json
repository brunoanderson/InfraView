{
  "name": "infraview",
  "version": "1.0.0",
  "description": "InfraView - dashboard de NOC para monitoramento de disponibilidade (UP/DOWN) de dispositivos de rede.",
  "private": true,
  "scripts": {
    "start": "node scripts/dev.mjs",
    "api": "json-server db.json --port 3000",

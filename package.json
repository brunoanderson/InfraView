    "reset": "node scripts/reset.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "json-server": "^1.0.0-beta.15"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  }
}
